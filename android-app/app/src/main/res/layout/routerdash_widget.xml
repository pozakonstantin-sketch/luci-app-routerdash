<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/routerdash_widget_background">

    <TextView
        android:id="@+id/widget_hostname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RouterDash"
        android:textColor="#F4F6F8"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OpenWrt"
        android:textColor="#9AA5B1"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Откройте приложение"
        android:textColor="#69C7F0"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CPU  —"
            android:textColor="#F4F6F8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RAM  —"
            android:textColor="#F4F6F8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_rx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="↓ —"
        android:textColor="#69C7F0"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_tx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="↑ —"
        android:textColor="#FF9A52"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_uptime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Uptime · —"
        android:textColor="#9AA5B1"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
